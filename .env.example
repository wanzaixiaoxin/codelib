# ---- 大模型（OpenAI 兼容，指向自己的网关/厂商）----
# 与 config/config.yaml 的 llm 对应
CODELIB_LLM_BASE_URL=http://127.0.0.1:3425/v1
CODELIB_LLM_API_KEY=
CODELIB_LLM_MODEL=workbuddy/glm-5.3

# 代码知识库指向的工程目录（只读）
CODELIB_WORKSPACE_PATH=D:/path/to/your/project

# 管理接口令牌（可选；设置后 /api/* 需带 X-Admin-Token）
CODELIB_ADMIN_TOKEN=

# ---- 企业微信（应用回调）----
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_WEBHOOK=

# ---- 飞书 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK=
